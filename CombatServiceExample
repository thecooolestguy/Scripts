-- State Tracking Tables
local M1Combos = {}       -- Maps Player/Model instances or UserIds to their current combo count
local M1ResetTimers = {}  -- Stores active coroutines responsible for resetting combo counts
local ActorAnimations = {}-- Tracks active animation tracks or states for characters

-- Utility: Cleans input strings by stripping HTML-like tags and non-alphanumeric characters
local function cleanString(str) : string
	str = str:gsub("<br%s*/>", "\n")
	str = str:gsub("<[^<>]->", "")
	str = str:gsub("[^%w]", "")

	return str
end

-- Utility: Iterates through a table's keys, cleans them, and checks if a target pattern exists
local function findPattern(givenTable, pattern)
	for i, v in pairs(givenTable) do
		if string.find(cleanString(i), pattern) then
			return true
		end
	end
	
	return false
end

-- Configuration settings for M1 combo timing windows (in seconds)
local M1Configs = {
	normal = 1.5, -- Window allowed before a normal attack combo resets
	fourth = 2.5  -- Extended window or recovery time after the finisher/4th hit
}

-- Server-side signal for combat action events
CombatService.PerformAction = Signal.new()

-- Schedules a reset of the user's M1 combo back to 1 if they idle longer than the specified duration
local function ScheduleM1Reset(user:Player|Model, duration:number)
	if user:IsA("Player") then
		-- Coroutine handler for human players (keyed by UserId)
		local m1Timer = coroutine.create(function()
			local startTime = os.clock()

			while (os.clock() - startTime) < duration do
				task.wait(0.1)
			end
			-- Reset combo count back to the start after timeout expires
			M1Combos[user.UserId] = 1
		end)
		M1ResetTimers[user.UserId] = m1Timer
		task.spawn(M1ResetTimers[user.UserId])
	else
		-- Coroutine handler for AI/NPC Models (keyed directly by Model instance)
		local m1Timer = coroutine.create(function()
			local startTime = os.clock()

			while (os.clock() - startTime) < duration do
				task.wait(0.1)
			end
			-- Reset combo count back to the start after timeout expires
			M1Combos[user] = 1
		end)
		M1ResetTimers[user] = m1Timer
		task.spawn(M1ResetTimers[user])
	end

end

